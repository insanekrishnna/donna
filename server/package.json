{
  "name": "donna-server",
  "version": "0.1.0",
  "description": "Donna API and agents",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:live": "node --import tsx --test --test-concurrency=1 test/live/*.test.ts",
    "smoke:arkiv": "tsx scripts/arkiv-smoke.ts",
    "seed": "tsx scripts/seed.ts",
    "buy:snapshot": "tsx scripts/buy-snapshot.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@x402/core": "^2.30.0",
    "@x402/express": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hedera": "^2.30.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.53.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.10.0"
  },
  "overrides": {
    "ethers": {
      "ws": "^8.21.0"
    }
  }
}
