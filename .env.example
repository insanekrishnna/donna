# Copy to .env and fill in values. Never commit .env.
# See ARCHITECTURE.md section 9 for what each variable does.
# Testnet only. Never put mainnet keys here.

# App
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# LLM: OpenAI-compatible endpoint (OpenRouter). Server-only secret.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Hedera testnet (ECDSA accounts from https://portal.hedera.com)
HEDERA_NETWORK=hedera:testnet
HEDERA_FACILITATOR_URL=https://x402.org/facilitator
HEDERA_MERCHANT_ACCOUNT_ID=
# Optional: not needed for HBAR payments
HEDERA_MERCHANT_PRIVATE_KEY=
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
# Decimal HBAR, converted to tinybars in config
MAX_PAYMENT_PER_CALL=0.10

# Arkiv (Rabdi testnet)
# Server access key from https://hub.arkiv.network/access-keys, with NO origin restriction
# (server requests have no Origin header). Treat it as a secret.
ARKIV_ACCESS_KEY=
ARKIV_CHAIN_ID=7794095
# Server wallet for task and assignment records, funded with tGLM from https://hub.arkiv.network/faucet
ARKIV_SERVER_PRIVATE_KEY=

# Client (Vite, public values only; these end up in the browser)
VITE_API_URL=http://localhost:4000
# Browser access key: a different key, restricted to the app's origins in the Hub
VITE_ARKIV_ACCESS_KEY=
VITE_ARKIV_CHAIN_ID=7794095
